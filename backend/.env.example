PORT=5000
MONGO_URI=mongodb://localhost:27017/asistente_lectura
# Opcional: true solo con MongoDB replica set o clúster compatible con transacciones.
# En una instancia standalone local, mantener false.
MONGO_USE_TRANSACTIONS=false
# OBLIGATORIO. Genera uno con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
# Correo exacto de la única cuenta autorizada al dashboard y gestión administrativa.
ADMIN_EMAIL=
GEMINI_API_KEY=
# Clave que debe escribir un docente al registrarse
TEACHER_SIGNUP_CODE=
# Mismo client id que VITE_GOOGLE_CLIENT_ID del frontend (solo si usas login con Google)
GOOGLE_CLIENT_ID=
# Envío de credenciales temporales (Gmail: usa una contraseña de aplicación)
EMAIL_SERVICE=gmail
EMAIL_USER=
EMAIL_PASS=
# Opcional: EMAIL_FROM=Nombre del sistema <cuenta@dominio.com>
# Solo producción: origen permitido por CORS
# CLIENT_URL=https://tu-dominio.com
